# Copy to .env and fill in. Used by server.js for form → email + SMS.

# Resend (email)
RESEND_API_KEY= re_L12wxniH_GF5cHkitnLaak3PvzDPdhi6F
RESEND_FROM_EMAIL= support@softandsupple.com

# Twilio (SMS) — when customer contact_preference is sms, transactional emails are mirrored as SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either a verified Twilio number (E.164) OR a Messaging Service SID (below), not both required.
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signed portal links in SMS (also set for one-tap login on payment.html?p=…)
# Generate a long random string; defaults to SUPPLE_CONTROLS_SESSION_SECRET if unset (not ideal for prod).
PORTAL_MAGIC_SECRET=
# PORTAL_MAGIC_TTL_SECONDS=604800

# Supabase (database) — optional until you wire forms/API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supple Controls panel (http://localhost:3000/supplecontrols)
SUPPLE_CONTROLS_USERNAME=
SUPPLE_CONTROLS_PASSWORD=
SUPPLE_CONTROLS_SESSION_SECRET=

# Stripe (Pay Now on payment portal)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Dev: footer sample PDF links on the home page (npm start only)
# DEV_PDF_SAMPLES=1

# California BAR repair document shop identity (estimate / invoice)
# BAR_REGISTRATION_NUMBER=ARD123456
# EPA_IDENTIFICATION_NUMBER=CAL7654321
# SHOP_NAME=Supple Automotive
# SHOP_ADDRESS=5395 Quailridge Dr., Camarillo, CA 93012
# SHOP_PHONE=(805) 443-4181
# SHOP_EMAIL=hlsbusiness@suppleautomotive.com
# SHOP_TIMEZONE=America/Los_Angeles

# Google Receipt Tracker (invoice submit → "Customer" sheet in Receipt Tracker - {year})
# 1) Create a service account in Google Cloud; enable Sheets API + Drive API.
# 2) Share your "Supple Automotive" Drive folder (or "Receipts" subfolder) with the service account email as Editor.
# 3) Set credentials below (private key: paste with literal \n between lines, or use JSON blob).
# GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Do NOT use a Google API key (AIza...) here — use the PEM private_key from the service account JSON.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Spreadsheet: direct ID (from URL) OR resolve via Drive folder:
# GOOGLE_RECEIPT_TRACKER_SPREADSHEET_ID=
# Optional if the sheet name differs from "Receipt Tracker - {year}" (e.g. typo "Reciept Tracker - 2026"):
# GOOGLE_RECEIPT_TRACKER_SHEET_NAME=Reciept Tracker - 2026
# GOOGLE_DRIVE_ROOT_FOLDER_ID=          # "Supple Automotive" folder ID → Receipts → {year} → Receipt Tracker - {year}
# GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=       # "Receipts" folder ID → {year} → Receipt Tracker - {year}
# GOOGLE_RECEIPT_PARTS_TAX_PERCENT=7.25  # CA parts tax % for "Collected Sales Tax" column

# Optional override for local customer export folder (default: ~/Desktop/Business Sheit/CustomerInfo)
# CUSTOMER_EXPORT_ROOT=

# Optional
PORT=3000
