# Copy to .env and fill in. Used by server.js for form → email + SMS.

# Resend (email)
RESEND_API_KEY= re_L12wxniH_GF5cHkitnLaak3PvzDPdhi6F
RESEND_FROM_EMAIL= support@softandsupple.com

# Twilio (SMS) — when customer contact_preference is sms, transactional emails are mirrored as SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either a verified Twilio number (E.164) OR a Messaging Service SID (below), not both required.
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signed portal links in SMS (also set for one-tap login on payment.html?p=…)
# Generate a long random string; defaults to SUPPLE_CONTROLS_SESSION_SECRET if unset (not ideal for prod).
PORTAL_MAGIC_SECRET=
# PORTAL_MAGIC_TTL_SECONDS=604800

# Supabase (database) — optional until you wire forms/API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supple Controls panel (http://localhost:3000/supplecontrols)
SUPPLE_CONTROLS_USERNAME=
SUPPLE_CONTROLS_PASSWORD=
SUPPLE_CONTROLS_SESSION_SECRET=

# Stripe (Pay Now on payment portal)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Dev: footer sample PDF links on the home page (npm start only)
# DEV_PDF_SAMPLES=1

# Optional
PORT=3000
