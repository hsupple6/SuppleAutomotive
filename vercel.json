{
  "redirects": [
    { "source": "/hayden-supple", "destination": "/hayden-supple/", "permanent": true },
    { "source": "/lifeos", "destination": "/lifeos/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/supplecontrols", "destination": "/server.js" },
    { "source": "/supplecontrols/:path*", "destination": "/server.js" },
    { "source": "/api/:path*", "destination": "/server.js" },
    { "source": "/sitemap.xml", "destination": "/server.js" },
    { "source": "/learn", "destination": "/server.js" },
    { "source": "/learn/:path*", "destination": "/server.js" },
    { "source": "/mobile-:path*", "destination": "/server.js" },
    { "source": "/at-home-:path*", "destination": "/server.js" },
    { "source": "/obhr330", "destination": "/obhr330/index.html" },
    { "source": "/obhr330/", "destination": "/obhr330/index.html" },
    { "source": "/lifeos/:token", "destination": "/lifeos/index.html" }
  ]
}
